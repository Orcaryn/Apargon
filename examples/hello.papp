<!doctype html>
<meta charset="utf-8">
<meta name="papp-write" content="./notes.txt">
<title>papp hello</title>
<style>
  body { font: 15px/1.5 system-ui; max-width: 720px; margin: 40px auto; padding: 0 20px; color: #222; }
  textarea { width: 100%; height: 200px; font: 14px/1.4 ui-monospace, monospace; }
</style>

<h1>A page that edits a file</h1>
<p>This is <code>notes.txt</code>, next to this page. Type, save, open it in any editor.
The page may see its own folder, and asks for one tag: to change <code>notes.txt</code>.
Nothing else.</p>
<textarea id="text"></textarea>
<p><button id="save">Save</button> <span id="saved"></span></p>

<script>
  const load = async () => {
    text.value = await papp.exists('notes.txt') ? await papp.readFile('notes.txt') : '';
  };
  load();
  papp.watch('notes.txt', load);
  save.onclick = async () => {
    await papp.writeFile('notes.txt', text.value);
    saved.textContent = 'saved ' + new Date().toLocaleTimeString();
  };
</script>
