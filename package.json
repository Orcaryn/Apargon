{
  "name": "resworb",
  "version": "0.1.0",
  "description": "A local page runner: full Node in the page, sockets and DNS denied by the OS.",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "start": "electron . examples/hello.lmth",
    "test": "node test/refuse.ts && electron . test/selftest.lmth && RESWORB_TEST_ALLOW=1 electron . test/selftest.nmth && cat test/result.json test/result-net.json",
    "dist": "electron-builder --mac --arm64 --x64",
    "dist:linux": "electron-builder --linux",
    "start:net": "RESWORB_TEST_ALLOW=1 electron . examples/net.nmth",
    "lint": "tsc && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "build": {
    "appId": "com.hammer.resworb",
    "productName": "resworb",
    "files": [
      "main.ts"
    ],
    "extraResources": [
      "sandbox/"
    ],
    "fileAssociations": [
      {
        "ext": "lmth",
        "name": "resworb page",
        "description": "resworb page",
        "mimeType": "application/x-resworb",
        "role": "Editor",
        "rank": "Owner",
        "icon": "build/lmth.icns"
      },
      {
        "ext": "nmth",
        "name": "resworb page with declared hosts",
        "description": "resworb page with declared hosts",
        "mimeType": "application/x-resworb-net",
        "role": "Editor",
        "rank": "Owner",
        "icon": "build/nmth.icns"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
