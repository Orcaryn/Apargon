{
  "name": "apargon",
  "version": "0.4.0",
  "description": "A local page runner: a page asks for folders, servers and programs in <meta> tags; the OS denies everything else on the network.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "electron . examples/hello.papp",
    "test": "rm -f test/selftest/pages/results/result*.json && node test/node/platforms.ts && node test/node/preload.ts && node test/node/popup.ts && node test/node/storage.ts && node test/selftest/refuse.ts && node test/selftest/daemons.ts && APARGON_TEST_ALLOW=1 electron . test/selftest/pages/selftest.papp && APARGON_TEST_ALLOW=1 electron . test/selftest/pages/selftest-system.papp && APARGON_TEST_ALLOW=1 APARGON_TEST_ENV=passed node test/selftest/listen.ts electron . test/selftest/pages/selftest-net.papp && { [ $(uname) != Darwin ] || APARGON_TEST_ALLOW=1 electron . test/selftest/pages/selftest-mac.papp; } && node test/selftest/check.ts",
    "dist": "electron-builder --mac --arm64 --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "start:net": "APARGON_TEST_ALLOW=1 electron . examples/net.papp",
    "lint": "tsc && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "homepage": "https://github.com/Orcaryn/Apargon",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/mxc-sdk": "1.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "build": {
    "appId": "com.hammer.apargon",
    "productName": "Apargon",
    "files": [
      "src/**",
      "skills/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "fileAssociations": [
      {
        "ext": "papp",
        "name": "papp page",
        "description": "papp page",
        "mimeType": "application/x-papp",
        "role": "Editor",
        "rank": "Owner",
        "icon": "build/papp.icns"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "A page you opened in Apargon asked to use the camera.",
        "NSMicrophoneUsageDescription": "A page you opened in Apargon asked to use the microphone.",
        "NSLocationUsageDescription": "A page you opened in Apargon asked for this computer's location.",
        "NSLocationWhenInUseUsageDescription": "A page you opened in Apargon asked for this computer's location.",
        "NSBluetoothAlwaysUsageDescription": "A page you opened in Apargon asked for a serial port; macOS lists Bluetooth ones among them."
      }
    },
    "deb": {
      "artifactName": "${name}_${arch}.${ext}",
      "depends": [
        "bubblewrap (>= 0.8.0)",
        "libasound2t64 | libasound2",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "HaMMeR",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${arch}.${ext}",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/@microsoft/mxc-sdk/bin/${arch}",
          "to": "mxc",
          "filter": [
            "wxc-exec.exe",
            "wslcsdk.dll"
          ]
        }
      ]
    },
    "nsis": {
      "perMachine": true,
      "buildUniversalInstaller": false
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3"
  }
}
