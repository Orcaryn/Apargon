{
  "name": "apargon",
  "version": "0.3.0",
  "description": "A local page runner: a page asks for folders, servers and programs in <meta> tags; the OS denies everything else on the network.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "electron . examples/hello.papp",
    "test": "rm -f test/result*.json && node test/popup.ts && node test/refuse.ts && node test/daemons.ts && APARGON_TEST_ALLOW=1 electron . test/selftest.papp && APARGON_TEST_ALLOW=1 electron . test/selftest-node.papp && APARGON_TEST_ALLOW=1 APARGON_TEST_ENV=passed electron . test/selftest-net.papp && node test/check.ts",
    "dist": "electron-builder --mac --arm64 --x64",
    "dist:linux": "electron-builder --linux --x64",
    "start:net": "APARGON_TEST_ALLOW=1 electron . examples/net.papp",
    "lint": "tsc && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "homepage": "https://github.com/Orcaryn/Apargon",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "build": {
    "appId": "com.hammer.apargon",
    "productName": "Apargon",
    "files": [
      "src/**",
      "skills/**"
    ],
    "extraResources": [
      "sandbox/"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "fileAssociations": [
      {
        "ext": "papp",
        "name": "papp page",
        "description": "papp page",
        "mimeType": "application/x-papp",
        "role": "Editor",
        "rank": "Owner",
        "icon": "build/papp.icns"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "A page you opened in Apargon asked to use the camera.",
        "NSMicrophoneUsageDescription": "A page you opened in Apargon asked to use the microphone.",
        "NSLocationUsageDescription": "A page you opened in Apargon asked for this computer's location.",
        "NSLocationWhenInUseUsageDescription": "A page you opened in Apargon asked for this computer's location."
      }
    },
    "deb": {
      "depends": [
        "bubblewrap (>= 0.8.0)",
        "libasound2t64 | libasound2",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "HaMMeR",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3"
  }
}
