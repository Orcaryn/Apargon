{
  "name": "apargon",
  "version": "0.5.1",
  "description": "A reverse browser: a .papp file reads your files, writes its own folder, and sends nothing off your computer unless you allow it in a <meta> tag.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "electron . examples/hello.papp",
    "test": "node test/run.ts",
    "dist": "electron-builder --mac --arm64 --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "start:net": "APARGON_TEST_ALLOW=1 electron . examples/net.papp",
    "lint": "tsc && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "homepage": "https://github.com/Orcaryn/Apargon",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "build": {
    "appId": "com.hammer.apargon",
    "productName": "Apargon",
    "files": [
      "src/**",
      "skills/**",
      "!node_modules/@microsoft/mxc-sdk/bin/**",
      "!node_modules/node-pty/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "fileAssociations": [
      {
        "ext": "papp",
        "name": "papp page",
        "description": "papp page",
        "mimeType": "application/x-papp",
        "role": "Editor",
        "rank": "Owner",
        "icon": "build/papp.icns"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "A .papp file you opened in Apargon asked to use the camera.",
        "NSMicrophoneUsageDescription": "A .papp file you opened in Apargon asked to use the microphone.",
        "NSLocationUsageDescription": "A .papp file you opened in Apargon asked for this computer's location.",
        "NSLocationWhenInUseUsageDescription": "A .papp file you opened in Apargon asked for this computer's location.",
        "NSBluetoothAlwaysUsageDescription": "A .papp file you opened in Apargon asked to use Bluetooth or a serial port."
      },
      "files": [
        "!node_modules/@microsoft/**",
        "!node_modules/koffi/**",
        "!node_modules/@koromix/**",
        "!node_modules/semver/**"
      ]
    },
    "deb": {
      "artifactName": "${name}_${arch}.${ext}",
      "depends": [
        "bubblewrap (>= 0.8.0)",
        "libasound2t64 | libasound2",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "HaMMeR",
      "icon": "build/icon.png",
      "files": [
        "!node_modules/@microsoft/**",
        "!node_modules/koffi/**",
        "!node_modules/@koromix/**",
        "!node_modules/semver/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${arch}.${ext}",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/@microsoft/mxc-sdk/bin/${arch}",
          "to": "mxc",
          "filter": [
            "mxc_ffi.dll",
            "wslcsdk.dll"
          ]
        }
      ],
      "files": [
        "!node_modules/@koromix/koffi-darwin-*/**"
      ]
    },
    "nsis": {
      "perMachine": true,
      "buildUniversalInstaller": false
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@microsoft/mxc-sdk": "1.0.1"
  }
}
