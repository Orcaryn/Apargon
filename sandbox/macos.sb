;; papp no-network profile for macOS (Seatbelt).
;; Everything allowed except sockets and the two services below. Children inherit
;; it, so `curl` from child_process fails too. DNS fails as well (mDNSResponder is a
;; socket).
(version 1)
(allow default)
(deny network*)
;; Mach IPC and the WindowServer are not "network"; the GUI keeps working.
;; Two system services fetch for a process, from outside its sandbox: background downloads
;; (nsurlsessiond) and WebKit's network process. Electron uses neither.
(deny mach-lookup (global-name "com.apple.nsurlsessiond") (xpc-service-name-prefix "com.apple.WebKit."))
