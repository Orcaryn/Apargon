<!doctype html>
<meta charset="utf-8">
<meta name="papp-net" content="example.com:443">
<meta name="papp-net" content="example.com:80">
<meta name="papp-net" content="*.example.org:443">
<meta name="papp-net" content="*:9">
<meta name="papp-run" content="curl">
<meta name="papp-run" content="touch">
<meta name="papp-run" content="cat">
<meta name="papp-run" content="env">
<meta name="papp-run" content="sh">
<meta name="papp-env" content="PAPP_TEST_ENV">
<meta name="papp-run" content="/usr/bin/open">
<meta name="papp-run" content="/usr/bin/osascript">
<meta name="papp-run" content="/usr/sbin/ipconfig">
<meta name="papp-run" content="/usr/bin/defaults">
<meta name="papp-read" content="../examples">
<meta name="papp-write" content="./result-net.json">
<meta name="papp-write" content="./touched*">
<title>papp selftest (net and programs)</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script type="module">
  const result = {};
  const refused = async (call) => {
    try { await call(); return false; } catch { return true; }
  };
  const curl = async (...args) => (await papp.run('curl', ['-s', '-o', '/dev/null', '-m', '5', '-w', '%{http_code}', ...args])).stdout;
  const mac = navigator.userAgent.includes('Macintosh');
  const fetchOk = (url) => fetch(url, { signal: AbortSignal.timeout(5000) }).then((r) => r.ok, () => false);

  try {
    result.curl_declared = await curl('https://example.com/') === '200';
    result.curl_undeclared_blocked = await curl('https://example.net/') !== '200';
    result.curl_direct_blocked = await curl('--noproxy', '*', 'https://example.com/') !== '200';
    const lan = mac ? (await papp.run('ipconfig', ['getifaddr', 'en0'])).stdout.trim() : '';
    result.proxy_refuses_this_computer = await curl('http://0.0.0.1:9/') === '403' && (lan === '' || await curl(`http://${lan}:9/`) === '403');
    result.proxy_refuses_local_network = (await Promise.all(['10.255.255.1', '192.168.255.1', '172.31.255.1', '169.254.169.254', '100.64.0.1'].map((address) => curl(`http://${address}:9/`)))).every((code) => code === '403');
    if (mac) {
      result.proxy_refuses_connect_without_port = (await papp.run('sh', ['-c', 'printf "CONNECT example.com HTTP/1.1\\r\\nHost: example.com\\r\\n\\r\\n" | nc -w 3 127.0.0.1 "${http_proxy##*:}" | head -1'])).stdout.includes('403');
    }

    result.read_granted = (await papp.readFile('../examples/hello.papp')).includes('papp');
    result.read_only = await refused(() => papp.writeFile('../examples/x.txt', 'x'));

    result.program_writes_granted = (await papp.run('touch', ['touched.tmp'])).status === 0;
    await papp.rm('touched.tmp');
    result.program_outside_write_blocked = (await papp.run('touch', ['../touched-outside.tmp'])).status !== 0;

    if (mac) {
      result.program_hidden_write_blocked = (await papp.run('touch', ['.touched.tmp'])).status !== 0;
      result.program_own_folder_write_blocked = (await papp.run('touch', ['own.tmp'])).status !== 0;
      result.program_page_write_blocked = (await papp.run('touch', ['touched.papp'])).status !== 0;
      result.program_open_app_blocked = (await papp.run('open', ['-g', '-a', 'Finder'])).status !== 0;
      result.program_apple_event_blocked = (await papp.run('osascript', ['-e', 'tell application "Finder" to get name of home'])).status !== 0;
      result.program_preference_write_blocked = (await papp.run('defaults', ['write', 'com.papp.selftest', 'leaked', '-bool', 'true'])).status !== 0;
    }

    result.program_input = (await papp.run('cat', [], { input: 'piped' })).stdout === 'piped';

    const env = (await papp.run('env')).stdout;
    result.program_env_named = env.includes('PAPP_TEST_ENV=passed') && /^HOME=/m.test(env);
    result.program_env_unnamed_left_out = !env.includes('PAPP_TEST_ALLOW=') && !env.includes('PAPP=');
    const ssh = await papp.run('sh', ['-c', 'ls -A "$HOME/.ssh"']);
    result.program_ssh_hidden = mac ? ssh.stderr.includes('Operation not permitted') : ssh.status === 0 && ssh.stdout === '';
    result.undeclared_program_refused = await refused(() => papp.run('ls'));

    if (!mac) {
      const folders = (await papp.run('sh', ['-c', 'ls -A "$HOME/.config/papp/net"'])).stdout.trim().split('\n');
      result.own_sockets_only = folders.length === 1 && folders[0].startsWith('page-');
      result.page_process_env_unnamed_left_out = (await papp.run('sh', ['-c', 'tr "\\0" "\\n" < /proc/$PPID/environ 2>/dev/null | grep -c "^PAPP_TEST_ALLOW="'])).stdout.trim() === '0';
    }
    result.options_as_args_refused = await refused(() => papp.run('touch', { cwd: '/' }));

    result.fetch_declared = await fetchOk('https://example.com/');
    result.fetch_declared_http = await fetchOk('http://example.com/');
    result.fetch_wildcard_subdomain = await fetchOk('https://www.example.org/');
    result.fetch_wildcard_apex_blocked = !(await fetchOk('https://example.org/'));
    result.fetch_undeclared_blocked = !(await fetchOk('https://example.net/'));
  } catch (err) {
    result.error = err.message;
  }

  document.body.textContent = JSON.stringify(result);
  await papp.writeFile('result-net.json', JSON.stringify(result, null, 2) + '\n');
  setTimeout(() => window.close(), 200);
</script>
