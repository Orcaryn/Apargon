<!doctype html>
<meta charset="utf-8">
<meta name="resworb-write" content="./result.json">
<meta name="resworb-write" content="./scratch*">
<title>resworb selftest</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script type="module">
  // Only writes: the page sees its own folder and its subfolders through window.resworb, and
  // changes only what resworb-write names. No Node, no files outside, no hidden files, no pages
  // but those a pattern names, no programs, no network. The two writes are only for the
  // results and scratch files: without them the own folder is the same, read-only.
  // Writes test/result.json and closes the window, which quits the app.
  const result = {};
  const refused = async (call) => {
    try { await call(); return false; } catch { return true; }
  };
  // The first file a watch reports while change runs and for a second after, or null.
  const changeSeen = async (watching, change) => {
    let seen = null;
    const stop = await resworb.watch(watching, (file) => { seen ??= file; });
    await change();
    await new Promise((done) => setTimeout(done, 1000));
    await stop();
    return seen;
  };
  const loads = (src) => new Promise((done) => {
    const script = document.createElement('script');
    script.src = src;
    script.onload = () => done(true);
    script.onerror = () => done(false);
    document.head.append(script);
  });

  // If this ever resolves, keep the evidence: what answered, from where.
  const fetched = fetch('https://example.com', { cache: 'no-store', signal: AbortSignal.timeout(3000) })
    .then((r) => {
      result.fetch_leak = { status: r.status, type: r.type, url: r.url };
      return false;
    }, () => true);

  // Asked, never used: the camera and microphone are only queried, the clipboard read is not kept.
  const permissions = Promise.all([
    Notification.requestPermission(),
    navigator.clipboard.readText().then(() => 'allowed', () => 'denied'),
    navigator.permissions.query({ name: 'camera' }).then((status) => status.state),
    navigator.permissions.query({ name: 'microphone' }).then((status) => status.state),
  ]);

  try {
    result.no_node = typeof require === 'undefined' && typeof process === 'undefined';

    result.own_folder_read = (await resworb.readFile('selftest.lmth')).includes('resworb selftest') && (await resworb.readdir('.')).includes('selftest-node.lmth');
    result.own_subfolder_read = (await resworb.readFile('subfolder/note.txt')).includes('subfolder');
    result.own_folder_write_refused = await refused(() => resworb.writeFile('own.txt', 'x'));
    result.own_subfolder_write_refused = await refused(() => resworb.writeFile('subfolder/x.txt', 'x')) && await refused(() => resworb.mkdir('sub'));

    await resworb.writeFile('scratch.txt', 'hi');
    result.granted_write = await resworb.readFile('scratch.txt') === 'hi' && (await resworb.readdir('.')).includes('scratch.txt');
    // A page that may change another could rewrite one approved for more: scratch* names no pages.
    result.page_write_refused = await refused(() => resworb.writeFile('scratch.lmth', 'x')) && await refused(() => resworb.writeFile('selftest-node.lmth', 'x'));
    result.page_rename_refused = await refused(() => resworb.rename('scratch.txt', 'scratch.lmth')) && await refused(() => resworb.rename('selftest-node.lmth', 'scratch.txt'));
    // Node would read { flag: 'w' } as options and empty the file.
    result.options_refused = await refused(() => resworb.readFile('scratch.txt', { flag: 'w' })) && await resworb.readFile('scratch.txt') === 'hi';

    result.watch_folder = await changeSeen('.', () => resworb.writeFile('scratch.txt', 'again')) === 'scratch.txt';
    // Editors save by renaming a new file over the old one; the watch must survive it.
    await resworb.writeFile('scratch.new', 'new');
    result.watch_file_renamed_over = await changeSeen('scratch.txt', () => resworb.rename('scratch.new', 'scratch.txt')) === 'scratch.txt';
    result.watch_outside_refused = await refused(() => resworb.watch('..', () => {}));
    result.watch_hidden_refused = await refused(() => resworb.watch('.hidden', () => {}));
    await resworb.rm('scratch.txt');
    await resworb.mkdir('scratch-dir');
    result.hidden_below_match_refused = await refused(() => resworb.writeFile('scratch-dir/.hidden', 'x'));
    await resworb.rm('scratch-dir');

    result.outside_read_refused = await refused(() => resworb.readFile('../package.json'));
    result.outside_write_refused = await refused(() => resworb.writeFile('../outside.txt', 'x'));
    result.home_read_refused = await refused(() => resworb.readdir('~'));
    result.hidden_write_refused = await refused(() => resworb.writeFile('.hidden', 'x'));
    result.run_refused = await refused(() => resworb.run('ls'));

    result.fetch_blocked = await fetched;
    result.outside_file_url_refused = !(await loads('../package.json'));
    result.permissions_denied = (await permissions).every((answer) => answer === 'denied');
  } catch (err) {
    result.error = err.message; // check.ts fails on it, and the window still closes
  }

  document.body.textContent = JSON.stringify(result);
  await resworb.writeFile('result.json', JSON.stringify(result, null, 2) + '\n');
  setTimeout(() => window.close(), 200);
</script>
