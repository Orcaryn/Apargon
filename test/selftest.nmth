<!doctype html>
<meta charset="utf-8">
<meta name="resworb-net" content="example.com:443">
<meta name="resworb-net" content="example.com:80">
<title>resworb selftest (net)</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script>
  // Node must work. The declared host must be reachable, by fetch and by curl, https and http.
  // Every other route out must fail: undeclared hosts, direct sockets, DNS.
  // Writes test/result-net.json and closes the window, which quits the app.
  const fs = require('fs');
  const net = require('net');
  const path = require('path');
  const dns = require('dns');
  const { execSync } = require('child_process');

  const here = path.dirname(decodeURIComponent(location.pathname));
  const result = {};

  result.fs = fs.readFileSync(path.join(here, 'selftest.nmth'), 'utf8').includes('resworb-net');

  const curl = (url) => {
    try { return execSync(`curl -s -o /dev/null -m 5 -w '%{http_code}' ${url}`).toString(); }
    catch { return 'blocked'; }
  };
  result.curl_declared = curl('https://example.com/') === '200';
  result.curl_undeclared_blocked = curl('https://example.org/') !== '200';

  const fetchOk = (url) => fetch(url, { signal: AbortSignal.timeout(5000) }).then((r) => r.ok, () => false);
  const direct = new Promise((done) => {
    // TEST-NET-1 (RFC 5737): reserved for documentation, never a real service.
    const s = net.connect({ host: '192.0.2.1', port: 443, timeout: 2000 });
    s.once('connect', () => done(false));
    s.once('timeout', () => done(false));
    s.once('error', () => done(true));
  });
  const resolved = new Promise((done) => dns.lookup('example.com', (err) => done(!!err)));

  Promise.all([
    fetchOk('https://example.com/'),
    fetchOk('http://example.com/'),
    fetchOk('https://example.org/'),
    direct,
    resolved,
  ]).then(([declared, declaredPlain, undeclared, directBlocked, dnsBlocked]) => {
    result.fetch_declared = declared;
    result.fetch_declared_http = declaredPlain;
    result.fetch_undeclared_blocked = !undeclared;
    result.direct_socket_blocked = directBlocked;
    result.dns_blocked = dnsBlocked;
    document.body.textContent = JSON.stringify(result);
    fs.writeFileSync(path.join(here, 'result-net.json'), JSON.stringify(result, null, 2) + '\n');
    setTimeout(() => window.close(), 200);
  });
</script>
