<!doctype html>
<meta charset="utf-8">
<meta name="papp-write" content="./result.json">
<meta name="papp-write" content="./scratch*">
<title>papp selftest</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script type="module">
  const result = {};
  const refused = async (call) => {
    try { await call(); return false; } catch { return true; }
  };
  const changeSeen = async (watching, change) => {
    let seen = null;
    const stop = await papp.watch(watching, (file) => { seen ??= file; });
    await change();
    await new Promise((done) => setTimeout(done, 1000));
    await stop();
    return seen;
  };
  const loads = (src) => new Promise((done) => {
    const script = document.createElement('script');
    script.src = src;
    script.onload = () => done(true);
    script.onerror = () => done(false);
    document.head.append(script);
  });

  const fetched = fetch('https://example.com', { cache: 'no-store', signal: AbortSignal.timeout(3000) })
    .then((r) => {
      result.fetch_leak = { status: r.status, type: r.type, url: r.url };
      return false;
    }, () => true);

  const permissions = Promise.all([
    Notification.requestPermission(),
    navigator.clipboard.readText().then(() => 'allowed', () => 'denied'),
    navigator.permissions.query({ name: 'camera' }).then((status) => status.state),
    navigator.permissions.query({ name: 'microphone' }).then((status) => status.state),
  ]);

  try {
    result.no_node = typeof require === 'undefined' && typeof process === 'undefined';
    localStorage.setItem('papp-selftest', 'kept by selftest.papp');
    result.storage_own = localStorage.getItem('papp-selftest') === 'kept by selftest.papp';

    result.own_folder_read = (await papp.readFile('selftest.papp')).includes('papp selftest') && (await papp.readdir('.')).includes('selftest-node.papp');
    result.own_subfolder_read = (await papp.readFile('subfolder/note.txt')).includes('subfolder');
    result.own_folder_write_refused = await refused(() => papp.writeFile('own.txt', 'x'));
    result.own_subfolder_write_refused = await refused(() => papp.writeFile('subfolder/x.txt', 'x')) && await refused(() => papp.mkdir('sub'));

    await papp.writeFile('scratch.txt', 'hi');
    result.granted_write = await papp.readFile('scratch.txt') === 'hi' && (await papp.readdir('.')).includes('scratch.txt');
    result.page_write_refused = await refused(() => papp.writeFile('scratch.papp', 'x')) && await refused(() => papp.writeFile('selftest-node.papp', 'x'));
    result.page_rename_refused = await refused(() => papp.rename('scratch.txt', 'scratch.papp')) && await refused(() => papp.rename('selftest-node.papp', 'scratch.txt'));
    result.options_refused = await refused(() => papp.readFile('scratch.txt', { flag: 'w' })) && await papp.readFile('scratch.txt') === 'hi';

    result.watch_folder = await changeSeen('.', () => papp.writeFile('scratch.txt', 'again')) === 'scratch.txt';
    await papp.writeFile('scratch.new', 'new');
    result.watch_file_renamed_over = await changeSeen('scratch.txt', () => papp.rename('scratch.new', 'scratch.txt')) === 'scratch.txt';
    result.watch_outside_refused = await refused(() => papp.watch('..', () => {}));
    result.watch_hidden_refused = await refused(() => papp.watch('.hidden', () => {}));
    await papp.rm('scratch.txt');
    await papp.mkdir('scratch-dir');
    result.hidden_below_match_refused = await refused(() => papp.writeFile('scratch-dir/.hidden', 'x'));
    await papp.rm('scratch-dir');

    result.outside_read_refused = await refused(() => papp.readFile('../package.json'));
    result.outside_write_refused = await refused(() => papp.writeFile('../outside.txt', 'x'));
    result.home_read_refused = await refused(() => papp.readdir('~'));
    result.hidden_write_refused = await refused(() => papp.writeFile('.hidden', 'x'));
    result.run_refused = await refused(() => papp.run('ls'));

    result.fetch_blocked = await fetched;
    result.outside_file_url_refused = !(await loads('../package.json'));
    result.other_file_frame_refused = await new Promise((done) => {
      const frame = document.createElement('iframe');
      frame.src = 'subfolder/frame.html';
      document.body.append(frame);
      setTimeout(() => done(!window.framed), 1000);
    });
    result.permissions_denied = (await permissions).every((answer) => answer === 'denied');
  } catch (err) {
    result.error = err.message;
  }

  document.body.textContent = JSON.stringify(result);
  await papp.writeFile('result.json', JSON.stringify(result, null, 2) + '\n');
  setTimeout(() => window.close(), 200);
</script>
