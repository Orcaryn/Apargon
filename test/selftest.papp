<!doctype html>
<meta charset="utf-8">
<meta name="papp-write" content="./result.json">
<meta name="papp-write" content="./scratch*">
<title>Apargon selftest</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script type="module">
  if (location.hash === '#second') {
    document.body.textContent = 'second window';
    await new Promise(() => {});
  }

  const result = {};
  const refused = async (call) => {
    try { await call(); return false; } catch { return true; }
  };
  const changeSeen = async (watching, change, options) => {
    let seen = null;
    const stop = await papp.watch(watching, (file, kind) => { seen ??= `${file} ${kind}`; }, options);
    await change();
    await new Promise((done) => setTimeout(done, 1000));
    await stop();
    return seen;
  };
  const loads = (src) => new Promise((done) => {
    const script = document.createElement('script');
    script.src = src;
    script.onload = () => done(true);
    script.onerror = () => done(false);
    document.head.append(script);
  });

  const fetched = fetch('https://example.com', { cache: 'no-store', signal: AbortSignal.timeout(3000) })
    .then((r) => {
      result.fetch_leak = { status: r.status, type: r.type, url: r.url };
      return false;
    }, () => true);

  const permissions = Promise.all([
    Notification.requestPermission(),
    navigator.clipboard.readText().then(() => 'allowed', () => 'denied'),
    navigator.permissions.query({ name: 'camera' }).then((status) => status.state),
    navigator.permissions.query({ name: 'microphone' }).then((status) => status.state),
  ]);

  try {
    result.no_node = typeof require === 'undefined' && typeof process === 'undefined';
    localStorage.setItem('apargon-selftest', 'kept by selftest.papp');
    result.storage_own = localStorage.getItem('apargon-selftest') === 'kept by selftest.papp';

    result.own_folder_read = (await papp.readFile('selftest.papp')).includes('Apargon selftest') && (await papp.readdir('.')).includes('selftest-node.papp');
    result.own_subfolder_read = (await papp.readFile('subfolder/note.txt')).includes('subfolder');
    result.own_folder_write_refused = await refused(() => papp.writeFile('own.txt', 'x'));
    result.own_subfolder_write_refused = await refused(() => papp.writeFile('subfolder/x.txt', 'x')) && await refused(() => papp.mkdir('sub'));

    await papp.writeFile('scratch.txt', 'hi');
    result.granted_write = await papp.readFile('scratch.txt') === 'hi' && (await papp.readdir('.')).includes('scratch.txt');
    result.page_write_refused = await refused(() => papp.writeFile('scratch.papp', 'x')) && await refused(() => papp.writeFile('selftest-node.papp', 'x'));
    result.page_rename_refused = await refused(() => papp.rename('scratch.txt', 'scratch.papp')) && await refused(() => papp.rename('selftest-node.papp', 'scratch.txt'));
    result.options_refused = await refused(() => papp.readFile('scratch.txt', { flag: 'w' })) && await papp.readFile('scratch.txt') === 'hi';

    result.watch_folder = await changeSeen('.', () => papp.writeFile('scratch.txt', 'again')) === 'scratch.txt changed';
    await papp.writeFile('scratch.new', 'new');
    result.watch_file_renamed_over = await changeSeen('scratch.txt', () => papp.rename('scratch.new', 'scratch.txt')) === 'scratch.txt changed';
    result.watch_survives_second_window = await changeSeen('.', async () => {
      const second = window.open('#second');
      await new Promise((done) => setTimeout(done, 1500));
      await papp.writeFile('scratch.txt', 'seen from the first window');
      second.close();
    }) === 'scratch.txt changed';
    result.watch_removed = await changeSeen('scratch.txt', () => papp.rm('scratch.txt')) === 'scratch.txt removed';
    await papp.mkdir('scratch-dir');
    const deep = [];
    const stopDeep = await papp.watch('.', (file, kind) => deep.push(`${file} ${kind}`), { recursive: true });
    await papp.writeFile('scratch-dir/deep.txt', 'x');
    await new Promise((done) => setTimeout(done, 1000));
    await stopDeep();
    result.watch_recursive = deep.includes('scratch-dir/deep.txt changed');
    await papp.rm('scratch-dir');
    await papp.writeFile('scratch.txt', 'again');
    result.watch_outside_refused = await refused(() => papp.watch('..', () => {}));
    result.watch_hidden_refused = await refused(() => papp.watch('.hidden', () => {}));
    await papp.rm('scratch.txt');
    await papp.mkdir('scratch-dir');
    result.hidden_below_match_refused = await refused(() => papp.writeFile('scratch-dir/.hidden', 'x'));
    await papp.rm('scratch-dir');

    const listed = await papp.readdir('.', { stats: true });
    const entry = (name) => listed.find((item) => item.name === name);
    result.readdir_stats = entry('subfolder')?.isDirectory === true && entry('selftest.papp')?.isFile === true && entry('selftest.papp').size > 0 && !listed.some((item) => item.name.startsWith('.'));
    const note = await papp.readFile('subfolder/note.txt');
    result.read_range = await papp.readFile('subfolder/note.txt', 'utf8', { offset: 2, length: 4 }) === note.slice(2, 6) && (await papp.readFile('subfolder/note.txt', null, { offset: 1 })).length === note.length - 1;
    await papp.writeFile('scratch.txt', 'a');
    await papp.appendFile('scratch.txt', 'b');
    result.append = await papp.readFile('scratch.txt') === 'ab';
    result.append_refused = await refused(() => papp.appendFile('own.txt', 'x')) && await refused(() => papp.appendFile('selftest-node.papp', 'x'));
    await papp.copyFile('subfolder/note.txt', 'scratch-copy.txt');
    result.copy = await papp.readFile('scratch-copy.txt') === note;
    await papp.rm('scratch-copy.txt');
    result.copy_refused = await refused(() => papp.copyFile('../package.json', 'scratch-copy.txt')) && await refused(() => papp.copyFile('subfolder/note.txt', 'own.txt')) && await refused(() => papp.copyFile('selftest.papp', 'scratch.papp'));
    await papp.rm('scratch.txt');
    result.save_names_refused = (await Promise.all([{}, { '../out.txt': 'x' }, { 'sub/out.txt': 'x' }, { '.zshrc': 'x' }, { 'ok.txt': 'x', 'page.papp': 'x' }, { 'ok.txt': 'x', '': 'x' }].map((files) => refused(() => papp.saveAs(files))))).every(Boolean);

    result.outside_read_refused = await refused(() => papp.readFile('../package.json'));
    result.outside_write_refused = await refused(() => papp.writeFile('../outside.txt', 'x'));
    result.home_read_refused = await refused(() => papp.readdir('~'));
    result.hidden_write_refused = await refused(() => papp.writeFile('.hidden', 'x'));
    result.run_refused = await refused(() => papp.run('ls'));
    result.spawn_refused = await refused(() => papp.spawn('ls'));
    result.use_refused = await refused(() => papp.notify('selftest', 'should not show'));
    result.open_type_refused = await refused(() => papp.open('selftest.papp')) && await refused(() => papp.open('subfolder/frame.html')) && await refused(() => papp.open('subfolder/bundle.app'));
    result.open_outside_refused = await refused(() => papp.open('../package.json'));
    result.open_scheme_refused = (await Promise.all(['vscode://file/etc/passwd', 'file:///etc/passwd', 'javascript:1'].map((href) => refused(() => papp.open(href))))).every(Boolean);
    result.screen_capture_refused = await refused(() => navigator.mediaDevices.getDisplayMedia({ video: true }));
    result.other_file_window_refused = window.open('subfolder/frame.html') === null;

    result.fetch_blocked = await fetched;
    result.outside_file_url_refused = !(await loads('../package.json'));
    result.other_file_frame_refused = await new Promise((done) => {
      const frame = document.createElement('iframe');
      frame.src = 'subfolder/frame.html';
      document.body.append(frame);
      setTimeout(() => done(!window.framed), 1000);
    });
    result.permissions_denied = (await permissions).every((answer) => answer === 'denied');
  } catch (err) {
    result.error = err.message;
  }

  document.body.textContent = JSON.stringify(result);
  await papp.writeFile('result.json', JSON.stringify(result, null, 2) + '\n');
  setTimeout(() => window.close(), 200);
</script>
