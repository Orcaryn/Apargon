<!doctype html>
<meta charset="utf-8">
<meta name="papp-net" content="example.com">
<meta name="papp-net" content="example.com:80">
<meta name="papp-net" content="*.example.org">
<meta name="papp-net" content="*:9">
<meta name="papp-net" content="10.255.255.2:9">
<meta name="papp-net" content="localhost:47181">
<meta name="papp-net" content="localhost:47183">
<meta name="papp-listen" content="localhost">
<meta name="papp-socket" content="./results/declared.sock">
<meta name="papp-run" content="curl">
<meta name="papp-run" content="touch">
<meta name="papp-run" content="cat">
<meta name="papp-run" content="env">
<meta name="papp-run" content="sh">
<meta name="papp-run" content="./bin/greet">
<meta name="papp-env" content="APARGON_TEST_ENV">
<meta name="papp-read" content="../../../examples/">
<meta name="papp-write" content="./results/result-net.json">
<meta name="papp-write" content="./touched/*">
<meta name="papp-use" content="clipboard">
<meta name="papp-use" content="microphone">
<title>Apargon selftest (net and programs)</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script type="module">
  const result = {};
  const refused = async (call) => {
    try { await call(); return false; } catch { return true; }
  };
  const curl = async (...args) => (await papp.run('curl', ['-s', '-o', '/dev/null', '-m', '5', '-w', '%{http_code}', ...args])).stdout;
  const mac = navigator.userAgent.includes('Macintosh');
  const fetchOk = (url) => fetch(url, { signal: AbortSignal.timeout(5000) }).then((r) => r.ok, () => false);

  try {
    result.curl_declared = await curl('https://example.com/') === '200';
    result.curl_undeclared_blocked = await curl('https://example.net/') !== '200';
    result.curl_direct_blocked = await curl('--noproxy', '*', 'https://example.com/') !== '200';
    result.proxy_refuses_this_computer = await curl('http://0.0.0.1:9/') === '403';
    // *:9 matches any host: still not this computer, which only a tag naming localhost:<port> reaches.
    result.proxy_wildcard_refuses_this_computer = (await Promise.all(['localhost', '127.0.0.1'].map((host) => curl('--noproxy', '', `http://${host}:9/`)))).every((code) => code === '403');
    result.proxy_refuses_local_network = (await Promise.all(['10.255.255.1', '192.168.255.1', '172.31.255.1', '169.254.169.254', '100.64.0.1'].map((address) => curl(`http://${address}:9/`)))).every((code) => code === '403');
    result.proxy_allows_declared_lan_address = await curl('http://10.255.255.2:9/') !== '403';
    if (mac) {
      result.proxy_refuses_connect_without_port = (await papp.run('sh', ['-c', 'printf "CONNECT example.com HTTP/1.1\\r\\nHost: example.com\\r\\n\\r\\n" | nc -w 3 127.0.0.1 "${http_proxy##*:}" | head -1'])).stdout.includes('403');
    }

    // test/selftest/listen.ts serves these: the sandbox must keep out the port and socket file not declared.
    result.local_port_declared = await curl('--noproxy', '*', 'http://127.0.0.1:47181/') === '200';
    result.local_port_undeclared_blocked = await curl('--noproxy', '*', 'http://127.0.0.1:47182/') !== '200';
    result.socket_declared = await curl('--unix-socket', 'results/declared.sock', 'http://listener/') === '200';
    // Linux lets a page reach a socket file in a folder it sees: SECURITY.md lists it.
    if (mac) {
      result.socket_undeclared_blocked = await curl('--unix-socket', 'results/other.sock', 'http://listener/') !== '200';
    }

    result.read_granted = (await papp.readFile('../../../examples/hello.papp')).includes('papp');
    result.read_only = await refused(() => papp.writeFile('../../../examples/x.txt', 'x'));

    result.program_writes_granted = (await papp.run('touch', ['touched/x.tmp'])).status === 0;
    await papp.rm('touched/x.tmp');
    result.program_outside_write_blocked = (await papp.run('touch', ['../touched-outside.tmp'])).status !== 0;
    // ./touched/* is a folder of its own: on every OS a program cannot write beside the page or over it.
    result.program_hidden_write_blocked = (await papp.run('touch', ['.touched.tmp'])).status !== 0;
    result.program_own_folder_write_blocked = (await papp.run('touch', ['own.tmp'])).status !== 0;
    result.program_page_write_blocked = (await papp.run('touch', ['touched.papp'])).status !== 0;

    result.program_bundled_runs = (await papp.run('greet', ['x'])).stdout === 'bundled x\n';
    // Not the page's pipes to the trampoline (fds 3 and 5): with them, a program could ask it anything as this page.
    result.program_no_trampoline_fds = (await papp.run('sh', ['-c', '{ echo >&3 || echo >&5; } 2>/dev/null && echo open || echo closed'])).stdout === 'closed\n';
    result.program_input = (await papp.run('cat', [], { input: 'piped' })).stdout === 'piped';
    const bytes = (await papp.run('cat', [], { input: new Uint8Array([0, 255, 10, 1]), encoding: null })).stdout;
    result.program_bytes = bytes instanceof Uint8Array && bytes.join() === '0,255,10,1';
    const started = Date.now();
    const timedOut = await papp.run('sh', ['-c', 'sleep 30; echo late'], { timeout: 500 });
    result.program_timeout = timedOut.signal === 'SIGTERM' && timedOut.stdout === '' && Date.now() - started < 5000;

    const chunks = [];
    const lines = await papp.spawn('sh', ['-c', 'echo one; sleep 1; echo two'], { onOutput: (_stream, text) => chunks.push(text) });
    result.spawn_streams = (await lines.closed).status === 0 && chunks.join('') === 'one\ntwo\n' && chunks[0] === 'one\n';
    let echoed = '';
    const cat = await papp.spawn('cat', [], { onOutput: (_stream, text) => (echoed += text) });
    await cat.write('piped');
    await cat.end();
    result.spawn_input = (await cat.closed).status === 0 && echoed === 'piped';
    const sleeper = await papp.spawn('sh', ['-c', 'sleep 30; echo late']);
    await sleeper.close();
    const stopped = await Promise.race([sleeper.closed, new Promise((resolve) => setTimeout(() => resolve(null), 5000))]);
    result.spawn_kill = stopped?.signal === 'SIGTERM';
    result.spawn_undeclared_refused = await refused(() => papp.spawn('ls'));
    result.spawn_options_as_args_refused = await refused(() => papp.spawn('touch', { cwd: '/' }));

    const env = (await papp.run('env')).stdout;
    result.program_env_named = env.includes('APARGON_TEST_ENV=passed') && /^HOME=/m.test(env);
    result.program_env_unnamed_left_out = !env.includes('APARGON_TEST_ALLOW=') && !env.includes('APARGON=');
    result.undeclared_program_refused = await refused(() => papp.run('ls'));

    if (!mac) {
      const folders = (await papp.run('sh', ['-c', 'ls -A "$HOME/.config/apargon/net"'])).stdout.trim().split('\n');
      result.own_sockets_only = folders.length === 1 && folders[0].startsWith('page-');
      result.page_process_env_unnamed_left_out = (await papp.run('sh', ['-c', 'tr "\\0" "\\n" < /proc/$PPID/environ 2>/dev/null | grep -c "^APARGON_TEST_ALLOW="'])).stdout.trim() === '0';
    }
    result.options_as_args_refused = await refused(() => papp.run('touch', { cwd: '/' }));

    // Its own listener, on a port the page declares so the sandbox lets it ask.
    const asked = [];
    const server = await papp.listen({ port: 47183 }, (request) => {
      asked.push(`${request.method} ${new URL(request.url).pathname}${new URL(request.url).search} ${request.headers['x-probe']} ${new TextDecoder().decode(request.body)}`);
      return { status: 201, headers: { 'x-answer': 'yes' }, body: 'answered' };
    });
    const answer = await fetch('http://127.0.0.1:47183/path?q=1', { method: 'POST', headers: { 'x-probe': 'p' }, body: 'hello', signal: AbortSignal.timeout(5000) }).catch((err) => err);
    const answered = answer instanceof Response ? { url: server.url, status: answer.status, header: answer.headers.get('x-answer'), text: await answer.text(), asked: asked.join() } : { url: server.url, error: String(answer), asked: asked.join() };
    const expected = { url: 'http://127.0.0.1:47183', status: 201, header: 'yes', text: 'answered', asked: 'POST /path?q=1 p hello' };
    result.listen_answers = JSON.stringify(answered) === JSON.stringify(expected) || answered;
    await server.close();
    result.listen_closed = await server.closed === null && !(await fetchOk('http://127.0.0.1:47183/'));

    result.fetch_declared = await fetchOk('https://example.com/');
    result.fetch_declared_http = await fetchOk('http://example.com/');
    result.fetch_wildcard_subdomain = await fetchOk('https://www.example.org/');
    result.fetch_wildcard_apex_blocked = !(await fetchOk('https://example.org/'));
    result.fetch_undeclared_blocked = !(await fetchOk('https://example.net/'));
    // A raw request over papp.connect, as a database or mail client would speak its own protocol.
    const talk = async (host, port, options) => {
      const chunks = [];
      const connection = await papp.connect(host, port, { ...options, onData: (bytes) => chunks.push(new TextDecoder().decode(bytes)) });
      await connection.write(`GET / HTTP/1.0\r\nHost: ${host}\r\n\r\n`);
      await connection.closed;

      return chunks.join('');
    };
    result.connect_declared = /^HTTP\/1\.[01] 200/.test(await talk('localhost', 47181));
    result.connect_tls = /^HTTP\/1\.[01] 200/.test(await talk('example.com', 443, { tls: true }));
    result.connect_undeclared_refused = (await papp.connect('localhost', 47182).then(() => 'connected', (err) => err.message)).includes('may not connect');
    result.connect_local_network_refused = (await papp.connect('10.255.255.1', 9).then(() => 'connected', (err) => err.message)).includes('may not connect');
    result.connect_wildcard_refuses_this_computer = (await Promise.all(['localhost', '127.0.0.1'].map((host) => papp.connect(host, 9).then(() => 'connected', (err) => err.message)))).every((message) => message.includes('may not connect'));
    result.clipboard_read_granted = (await navigator.permissions.query({ name: 'clipboard-read' })).state === 'granted';
    result.microphone_permission_granted = (await navigator.permissions.query({ name: 'microphone' })).state === 'granted';
    result.camera_permission_denied_without_tag = (await navigator.permissions.query({ name: 'camera' })).state === 'denied';
  } catch (err) {
    result.error = err.message;
  }

  document.body.textContent = JSON.stringify(result);
  await papp.writeFile('results/result-net.json', JSON.stringify(result, null, 2) + '\n');
  setTimeout(() => window.close(), 200);
</script>
