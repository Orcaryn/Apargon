<!doctype html>
<meta charset="utf-8">
<meta name="papp-id" content="922d649a-0b4a-4f28-975a-2774474a2213">
<meta name="papp-system">
<title>Apargon selftest (papp-system)</title>
<script src="lib.js"></script>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script>
  // papp-system: no limits. The .papp file is a Node script, with the internet.
  (async () => {
    try {
      const fs = require('fs');
      const net = require('net');
      const os = require('os');
      const path = require('path');
      result.node = typeof process.versions.node === 'string';
      result.child_process = require('child_process').execFileSync(process.platform === 'win32' ? 'cmd' : 'sh', process.platform === 'win32' ? ['/c', 'echo ran'] : ['-c', 'echo ran'], { encoding: 'utf8' }).trim() === 'ran';
      const outside = path.join(os.tmpdir(), `apargon-system-${Date.now()}.tmp`);
      fs.writeFileSync(outside, 'x');
      result.writes_anywhere = fs.readFileSync(outside, 'utf8') === 'x';
      fs.rmSync(outside);
      // listen.ts serves 47182, which no tag names: papp-system reaches it directly.
      result.network = await new Promise((done) => {
        const socket = net.connect(47182, '127.0.0.1', () => {
          socket.destroy();
          done(true);
        });
        socket.on('error', (err) => done(err.code));
      });
      result.papp_api = (await papp.readdir('.')).includes('selftest-system.papp');
      result.window_shape_set = (await papp.window({ shape: [] })).shape.length === 0;
      await finish('system');
    } catch (err) {
      await finish('system', err);
    }

    setTimeout(() => papp.quit(), 200);
  })();
</script>
