<!doctype html>
<meta charset="utf-8">
<meta name="papp-system" content="full">
<meta name="papp-write" content="./results/result-win-system.json">
<title>Apargon selftest for Windows (full Node)</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script>
  const fs = require('fs');
  const os = require('os');
  const path = require('path');
  const dns = require('dns');
  const { fileURLToPath } = require('url');
  const { execSync } = require('child_process');

  const here = path.dirname(fileURLToPath(location.href));
  const result = {};

  // The sandbox's refusal, not a missing folder or a file already there: Windows answers access denied, as EPERM or EACCES by call. Any other code fails, named. test/run.ts makes Documents.
  const refusals = ['EPERM', 'EACCES'];
  try {
    fs.writeFileSync(path.join(os.homedir(), 'Documents', 'apargon-node.tmp'), 'hi');
    result.ungranted_write_refused = false;
  } catch (err) {
    result.ungranted_write_refused = refusals.includes(err.code) || err.code;
  }

  result.child_process = execSync('echo ok', { windowsHide: true }).toString().trim() === 'ok';
  result.storage_apart = localStorage.getItem('apargon-selftest') === null;

  const win = require('@electron/remote').getCurrentWindow();
  win.setAlwaysOnTop(true, 'floating');
  result.electron_window = win.isAlwaysOnTop();
  win.setAlwaysOnTop(false);

  try {
    fs.appendFileSync(path.join(process.env.APPDATA, 'apargon', 'grants.json'), '');
    result.grants_protected = false;
  } catch (err) {
    result.grants_protected = refusals.includes(err.code) || err.code;
  }

  // Only its own storage: another page's holds settings that page trusts, like its window. Partitions holds this page's own, so it exists.
  try {
    fs.mkdirSync(path.join(process.env.APPDATA, 'apargon', 'pages', 'Partitions', 'f'.repeat(64)));
    result.other_storage_write_blocked = false;
  } catch (err) {
    result.other_storage_write_blocked = refusals.includes(err.code) || err.code;
  }

  try {
    execSync('curl.exe -s -m 3 https://example.com', { windowsHide: true });
    result.curl_blocked = false;
  } catch {
    result.curl_blocked = true;
  }

  const fetched = fetch('https://example.com', { cache: 'no-store', signal: AbortSignal.timeout(3000) })
    .then((r) => {
      result.fetch_leak = { status: r.status, type: r.type, url: r.url };
      return false;
    }, () => true);
  const resolved = new Promise((done) => dns.lookup('example.com', (err) => done(!!err)));

  // The print spooler, as papp-use print needs it: every Windows runner has Microsoft Print to PDF.
  const printers = win.webContents.getPrintersAsync().then((list) => list.length > 0, () => false);

  Promise.all([fetched, resolved, printers]).then(([fetchBlocked, dnsBlocked, printersReachable]) => {
    result.fetch_blocked = fetchBlocked;
    result.dns_blocked = dnsBlocked;
    result.printers_reachable = printersReachable;
    document.body.textContent = JSON.stringify(result);
    fs.writeFileSync(path.join(here, 'results', 'result-win-system.json'), JSON.stringify(result, null, 2) + '\n');
    setTimeout(() => window.close(), 200);
  });
</script>
