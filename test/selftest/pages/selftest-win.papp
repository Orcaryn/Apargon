<!doctype html>
<meta charset="utf-8">
<meta name="papp-id" content="a5ac2006-46e0-4582-9bc6-afbe59339206">
<meta name="papp-net" content="example.com">
<meta name="papp-net" content="localhost:47181">
<title>Apargon selftest for Windows</title>
<script src="lib.js"></script>
<link rel="dns-prefetch" href="https://apg-leak-prefetch.example.com">
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script type="module">
  // Names starting apg-leak- must never reach the network: the Windows test looks for them in a packet capture.
  const loads = (src) => new Promise((done) => {
    const script = document.createElement('script');
    script.src = src;
    script.onload = () => done(true);
    script.onerror = () => done(false);
    document.head.append(script);
  });
  const fetches = (url) => fetch(url, { cache: 'no-store', signal: AbortSignal.timeout(5000) }).then((response) => response.ok, () => false);

  try {
    result.fetch_declared = await fetches('https://example.com');
    result.fetch_undeclared_blocked = !(await fetches('https://apg-leak-fetch.example.com'));
    // The Windows workflow serves these two ports, as listen.ts does elsewhere: localhost goes through the proxy, which lets only the declared port through.
    result.local_port_declared = await fetches('http://localhost:47181/');
    result.local_port_undeclared_blocked = !(await fetches('http://127.0.0.1:47182/'));
    result.network_path_refused = await refused(() => papp.readFile('//apg-leak-unc.example.com/share/x')) && await refused(() => papp.readdir('\\\\apg-leak-unc2.example.com\\share'));
    result.network_url_refused = !(await loads('file://apg-leak-file.example.com/share/x.js'));
    // In its own folder, but Windows reads these as other names: a stream of a file, or a name with its trailing dot or space dropped.
    result.page_stream_refused = await refused(() => papp.writeFile(`${papp.folder}\\scratch.papp::$DATA`, 'x')) && await refused(() => papp.writeFile(`${papp.folder}\\scratch.txt:hidden`, 'x'));
    result.page_trailing_dot_refused = await refused(() => papp.writeFile(`${papp.folder}\\scratch.papp.`, 'x')) && await refused(() => papp.writeFile(`${papp.folder}\\scratch.papp `, 'x'));

    const connection = new RTCPeerConnection({ iceServers: [{ urls: 'stun:apg-leak-stun.example.com:3478' }] });
    connection.createDataChannel('x');
    await connection.setLocalDescription(await connection.createOffer());
    await new Promise((done) => setTimeout(done, 3000));
    connection.close();
    await finish('win');
  } catch (err) {
    await finish('win', err);
  }

  setTimeout(() => papp.quit(), 200);
</script>
