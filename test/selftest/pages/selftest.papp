<!doctype html>
<meta charset="utf-8">
<meta name="papp-write" content="./results/result.json">
<meta name="papp-write" content="./scratch*">
<meta name="papp-write" content="./deep/**/*.md">
<title>Apargon selftest</title>
<body style="font: 14px ui-monospace, monospace; padding: 20px">running…</body>

<script type="module">
  if (location.hash === '#second') {
    document.body.textContent = 'second window';
    await new Promise(() => {});
  }

  const result = {};
  // Refused by Apargon itself, not failed some other way: a renamed call or a crash is not a refusal. What else happened goes to check.ts, as refused_wrongly.
  const wrong = [];
  const refused = async (call, expected = /^Error: Apargon: (?!no such call)/) => {
    const said = await call().then(() => 'not refused', (err) => `${err.name}: ${err.message}`);
    if (!expected.test(said)) {
      wrong.push(`${call}: ${said}`);
    }
    return expected.test(said);
  };
  const changeSeen = async (watching, change, options) => {
    let seen = null;
    const watcher = await papp.watch(watching, (file, kind) => { seen ??= `${file} ${kind}`; }, options);
    await change();
    for (let waited = 0; seen === null && waited < 3000; waited += 100) {
      await new Promise((done) => setTimeout(done, 100));
    }
    await watcher.close();
    return seen;
  };
  const loads = (src) => new Promise((done) => {
    const script = document.createElement('script');
    script.src = src;
    script.onload = () => done(true);
    script.onerror = () => done(false);
    document.head.append(script);
  });

  const fetched = fetch('https://example.com', { cache: 'no-store', signal: AbortSignal.timeout(3000) })
    .then((r) => {
      result.fetch_leak = { status: r.status, type: r.type, url: r.url };
      return false;
    }, () => true);

  const permissions = Promise.all([
    Notification.requestPermission(),
    navigator.clipboard.readText().then(() => 'allowed', () => 'denied'),
    navigator.permissions.query({ name: 'camera' }).then((status) => status.state),
    navigator.permissions.query({ name: 'microphone' }).then((status) => status.state),
  ]);

  try {
    result.no_node = typeof require === 'undefined' && typeof process === 'undefined';
    localStorage.setItem('apargon-selftest', 'kept by selftest.papp');
    result.storage_own = localStorage.getItem('apargon-selftest') === 'kept by selftest.papp';

    result.own_folder_read = (await papp.readFile('selftest.papp')).includes('Apargon selftest') && (await papp.readdir('.')).includes('selftest-system.papp');
    result.own_subfolder_read = (await papp.readFile('subfolder/note.txt')).includes('subfolder');
    result.own_folder_write_refused = await refused(() => papp.writeFile('own.txt', 'x'));
    result.own_subfolder_write_refused = await refused(() => papp.writeFile('subfolder/x.txt', 'x')) && await refused(() => papp.mkdir('sub'));

    await papp.writeFile('scratch.txt', 'hi');
    result.granted_write = await papp.readFile('scratch.txt') === 'hi' && (await papp.readdir('.')).includes('scratch.txt');
    result.page_write_refused = await refused(() => papp.writeFile('scratch.papp', 'x')) && await refused(() => papp.writeFile('selftest-system.papp', 'x'));
    result.page_rename_refused = await refused(() => papp.rename('scratch.txt', 'scratch.papp')) && await refused(() => papp.rename('selftest-system.papp', 'scratch.txt'));
    result.options_refused = await refused(() => papp.readFile('scratch.txt', { flag: 'w' })) && await papp.readFile('scratch.txt') === 'hi';

    result.watch_folder = await changeSeen('.', () => papp.writeFile('scratch.txt', 'again')) === 'scratch.txt changed';
    await papp.writeFile('scratch.new', 'new');
    result.watch_file_renamed_over = await changeSeen('scratch.txt', () => papp.rename('scratch.new', 'scratch.txt')) === 'scratch.txt changed';
    result.watch_survives_second_window = await changeSeen('.', async () => {
      const second = window.open('#second');
      await new Promise((done) => setTimeout(done, 1500));
      await papp.writeFile('scratch.txt', 'seen from the first window');
      second.close();
    }) === 'scratch.txt changed';
    result.watch_removed = await changeSeen('scratch.txt', () => papp.rm('scratch.txt')) === 'scratch.txt removed';
    await papp.mkdir('scratch-dir');
    const deep = [];
    const deepWatcher = await papp.watch('.', (file, kind) => deep.push(`${file} ${kind}`), { recursive: true });
    await papp.writeFile('scratch-dir/deep.txt', 'x');
    await new Promise((done) => setTimeout(done, 1000));
    await deepWatcher.close();
    result.watch_recursive = deep.includes('scratch-dir/deep.txt changed') && await deepWatcher.closed === null;
    // As Node's rm: the folder's own error, not Apargon's.
    result.rm_folder_needs_recursive = await refused(() => papp.rm('scratch-dir'), /^Error: Path is a directory: .*EISDIR/) && (await papp.readdir('scratch-dir')).includes('deep.txt');
    await papp.rm('scratch-dir', { recursive: true });
    await papp.writeFile('scratch.txt', 'again');
    result.watch_outside_refused = await refused(() => papp.watch('..', () => {}));
    result.watch_hidden_refused = await refused(() => papp.watch('.hidden', () => {}));
    await papp.rm('scratch.txt');
    await papp.mkdir('scratch-dir');
    result.hidden_below_match_refused = await refused(() => papp.writeFile('scratch-dir/.hidden', 'x'));
    await papp.rm('scratch-dir', { recursive: true });
    // ** is any number of folders, none hidden.
    await papp.writeFile('deep/top.md', 'x');
    await papp.writeFile('deep/sub/below.md', 'x');
    result.any_depth_write = (await papp.readdir('deep/sub')).includes('below.md');
    await papp.rm('deep/top.md');
    await papp.rm('deep/sub/below.md');
    result.any_depth_refused = await refused(() => papp.writeFile('deep/sub/other.txt', 'x')) && await refused(() => papp.writeFile('deep/sub/.hidden/x.md', 'x'));

    const listed = await papp.readdir('.', { stats: true });
    const entry = (name) => listed.find((item) => item.name === name);
    result.readdir_stats = entry('subfolder')?.isDirectory === true && entry('selftest.papp')?.isFile === true && entry('selftest.papp').size > 0 && !listed.some((item) => item.name.startsWith('.'));
    const note = await papp.readFile('subfolder/note.txt');
    result.read_range = await papp.readFile('subfolder/note.txt', { offset: 2, length: 4 }) === note.slice(2, 6) && (await papp.readFile('subfolder/note.txt', { encoding: null, offset: 1 })).length === note.length - 1;
    result.read_options_refused = await refused(() => papp.readFile('subfolder/note.txt', 'utf8'));
    await papp.writeFile('scratch.txt', 'a');
    await papp.appendFile('scratch.txt', 'b');
    result.append = await papp.readFile('scratch.txt') === 'ab';
    result.append_refused = await refused(() => papp.appendFile('own.txt', 'x')) && await refused(() => papp.appendFile('selftest-system.papp', 'x'));
    await papp.copyFile('subfolder/note.txt', 'scratch-copy.txt');
    result.copy = await papp.readFile('scratch-copy.txt') === note;
    await papp.rm('scratch-copy.txt');
    result.copy_refused = await refused(() => papp.copyFile('../../../package.json', 'scratch-copy.txt')) && await refused(() => papp.copyFile('subfolder/note.txt', 'own.txt')) && await refused(() => papp.copyFile('selftest.papp', 'scratch.papp'));
    await papp.rm('scratch.txt');
    const pdf = await papp.pdf();
    result.pdf_rendered = new TextDecoder().decode(pdf.slice(0, 5)) === '%PDF-';
    result.menu_set = (await papp.menu([{ label: 'Selftest', submenu: [{ label: 'Run', id: 'run', keys: 'CmdOrCtrl+Shift+9' }, { separator: true }, { label: 'Role smuggled', id: 'quit', role: 'quit' }] }])) === undefined;
    result.tray_set = (await papp.tray('Selftest', [{ label: 'Run', id: 'run' }, { separator: true }, { label: 'Role smuggled', id: 'quit', role: 'quit' }])) === undefined && (await papp.tray(null)) === undefined;
    result.tray_refused = await refused(() => papp.tray('x', 'not a list')) && await refused(() => papp.tray('x', [null]));
    result.progress_set = (await papp.progress(0.5)) === undefined && (await papp.progress(null)) === undefined;
    result.progress_refused = await refused(() => papp.progress(2)) && await refused(() => papp.progress('0.5')) && await refused(() => papp.progress(NaN));
    const power = await papp.power();
    result.power_read = typeof power.idleSeconds === 'number' && typeof power.onBattery === 'boolean';
    result.save_names_refused = (await Promise.all([{}, { '../out.txt': 'x' }, { 'sub/out.txt': 'x' }, { '.zshrc': 'x' }, { 'ok.txt': 'x', 'page.papp': 'x' }, { 'ok.txt': 'x', '': 'x' }].map((files) => refused(() => papp.saveAll(files))))).every(Boolean);
    result.given_empty = (await papp.given()).length === 0;
    // Each page's secrets are its own: selftest-net keeps a 'token' too, which this page must never see.
    result.secrets_per_page = await papp.getSecret('token') !== 'kept by selftest-net.papp';
    // 'token' stays: selftest-system then finds the secrets folder hidden with a file in it.
    await papp.setSecret('token', 'kept by selftest.papp');
    await papp.setSecret('gone', 'x');
    await papp.deleteSecret('gone');
    result.secret_roundtrip = await papp.getSecret('token') === 'kept by selftest.papp' && await papp.getSecret('gone') === null && await papp.getSecret('never') === null;
    result.secret_names_refused = await refused(() => papp.getSecret('')) && await refused(() => papp.setSecret('token', 5)) && await refused(() => papp.setSecret('token')) && await refused(() => papp.deleteSecret('x'.repeat(257)));

    result.outside_read_refused = await refused(() => papp.readFile('../../../package.json'));
    result.outside_write_refused = await refused(() => papp.writeFile('../outside.txt', 'x'));
    result.home_read_refused = await refused(() => papp.readdir('~'));
    result.hidden_write_refused = await refused(() => papp.writeFile('.hidden', 'x'));
    result.run_refused = await refused(() => papp.run('ls'));
    result.listen_refused = await refused(() => papp.listen({}, () => ({ body: 'x' })));
    result.spawn_refused = await refused(() => papp.spawn('ls'));
    result.use_refused = await refused(() => papp.notify('selftest', 'should not show')) && await refused(() => papp.print()) && await refused(() => window.print());
    result.open_type_refused = await refused(() => papp.open('selftest.papp')) && await refused(() => papp.open('subfolder/frame.html')) && await refused(() => papp.open('subfolder/bundle.app'));
    result.open_outside_refused = await refused(() => papp.open('../../../package.json'));
    result.open_scheme_refused = (await Promise.all(['vscode://file/etc/passwd', 'file:///etc/passwd', 'javascript:1'].map((href) => refused(() => papp.open(href))))).every(Boolean);
    result.screen_capture_refused = await refused(() => navigator.mediaDevices.getDisplayMedia({ video: true }), /^NotAllowedError: /);
    result.other_file_window_refused = window.open('subfolder/frame.html') === null;

    result.fetch_blocked = await fetched;
    result.outside_file_url_refused = !(await loads('../../../package.json'));
    result.other_file_frame_refused = await new Promise((done) => {
      const frame = document.createElement('iframe');
      frame.src = 'subfolder/frame.html';
      document.body.append(frame);
      setTimeout(() => done(!window.framed), 1000);
    });
    result.permissions_denied = (await permissions).every((answer) => answer === 'denied');
    // The window shows only the page: a page that could leave it would run another file with this page's access. Navigated, this script is gone and the result written first stays.
    await papp.writeFile('results/result.json', JSON.stringify({ ...result, navigation_refused: 'the window left the page' }, null, 2) + '\n');
    location.href = 'subfolder/frame.html';
    await new Promise((done) => setTimeout(done, 1000));
    result.navigation_refused = true;
  } catch (err) {
    result.error = err.message;
  }
  if (wrong.length) {
    result.refused_wrongly = wrong;
  }

  document.body.textContent = JSON.stringify(result);
  await papp.writeFile('results/result.json', JSON.stringify(result, null, 2) + '\n');
  setTimeout(() => window.close(), 200);
</script>
